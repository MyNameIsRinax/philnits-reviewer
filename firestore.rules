rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase user IDs of the admins (sign in at /admin.html to see yours). Add more as 'id1', 'id2'.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['fCM3hJK1HJPmmwXUaQJeh7VqIi92'];
    }

    // Testimonials sent from the site. Anyone can send one; only admins can read, change or delete them.
    match /submissions/{id} {
      allow create: if validStory(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    function validStory(d) {
      return d.keys().hasOnly(['name', 'exam', 'result', 'message', 'status', 'createdAt', 'ratings'])
        && d.keys().hasAll(['name', 'exam', 'result', 'message', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.exam is string && d.exam.matches('((April|October) 20[0-9]{2}|Not taken yet)?')
        && d.result in ['', 'Passed', 'Waiting for results', 'Did not pass yet']
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 600
        && d.status == 'pending'
        && d.createdAt == request.time
        && (!('ratings' in d) || validRatings(d.ratings));
    }

    // Optional 1-5 star ratings sent with a story. Only admins can read them.
    function validRatings(r) {
      return r is map && r.keys().hasOnly(['overall', 'explanations', 'lessons', 'ease'])
        && stars(r, 'overall') && stars(r, 'explanations') && stars(r, 'lessons') && stars(r, 'ease');
    }

    function stars(r, k) {
      return !(k in r) || (r[k] is int && r[k] >= 1 && r[k] <= 5);
    }

    // Approved testimonials shown on the home page, kept in one document so each visit costs one read.
    match /public/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anonymous daily usage counters, one document per day (Philippine time). No personal data.
    // Visitors can only add small amounts; only admins can read them.
    match /stats/{day} {
      allow read, delete: if isAdmin();
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && validCounters();
    }

    function before(k) {
      return resource == null ? 0 : resource.data.get(k, 0);
    }

    function grows(k) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int
            && request.resource.data[k] >= before(k)
            && request.resource.data[k] <= before(k) + 500);
    }

    function validCounters() {
      let d = request.resource.data;
      return d.keys().hasOnly(['visits', 'visitors', 'newVisitors', 'mobile', 'desktop',
                               'refDirect', 'refSearch', 'refSocial', 'refOther',
                               'answers', 'correct', 'mocks', 'lessons', 'flashcards', 'stories',
                               'ex', 'h', 'rt'])
        && grows('visits') && grows('visitors') && grows('newVisitors')
        && grows('mobile') && grows('desktop')
        && grows('refDirect') && grows('refSearch') && grows('refSocial') && grows('refOther')
        && grows('answers') && grows('correct') && grows('mocks')
        && grows('lessons') && grows('flashcards') && grows('stories')
        && (!('ex' in d) || (d.ex is map && d.ex.size() <= 80))
        && (!('h' in d) || (d.h is map && d.h.size() <= 24))
        && (!('rt' in d) || (d.rt is map && d.rt.size() <= 8));
    }
  }
}
